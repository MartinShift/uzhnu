digraph ArchKanbanPhysical {
  graph [rankdir=LR, bgcolor="white", splines=spline, nodesep=0.8, ranksep=2.0, pad=0.4, concentrate=false, fontname="Segoe UI", labelloc="t", fontsize=20, label=<<B>Arch Kanban — Physical schema</B>>];
  node  [shape=plain, fontname="Segoe UI", fontsize=11];
  edge  [fontname="Segoe UI", fontsize=12];

  Projects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD BGCOLOR="#1e3a8a" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Projects</B></FONT></TD></TR><TR><TD BGCOLOR="#eff6ff" ALIGN="CENTER" WIDTH="34"><B>PK</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT" PORT="Id"><B>Id</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Title"><B>Title</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(200)</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="ClientName"><B>ClientName</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(200)</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Description"><B>Description</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Stage"><B>Stage</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Priority"><B>Priority</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Position"><B>Position</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="DueDate"><B>DueDate</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="CreatedAt"><B>CreatedAt</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR></TABLE>>];
  Members [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD BGCOLOR="#1e3a8a" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Members</B></FONT></TD></TR><TR><TD BGCOLOR="#eff6ff" ALIGN="CENTER" WIDTH="34"><B>PK</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT" PORT="Id"><B>Id</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Name"><B>Name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(200)</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Role"><B>Role</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"><B>UQ</B></TD><TD ALIGN="LEFT" PORT="Username"><B>Username</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(100)</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="PasswordHash"><B>PasswordHash</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(200)</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="AccessLevel"><B>AccessLevel</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR></TABLE>>];
  ProjectMembers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD BGCOLOR="#1e3a8a" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>ProjectMembers</B></FONT></TD></TR><TR><TD BGCOLOR="#eff6ff" ALIGN="CENTER" WIDTH="34"><B>PK,FK</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT" PORT="ProjectId"><B>ProjectId</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD BGCOLOR="#eff6ff" ALIGN="CENTER" WIDTH="34"><B>PK,FK</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT" PORT="MemberId"><B>MemberId</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR></TABLE>>];
  Attachments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD BGCOLOR="#1e3a8a" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Attachments</B></FONT></TD></TR><TR><TD BGCOLOR="#eff6ff" ALIGN="CENTER" WIDTH="34"><B>PK</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT" PORT="Id"><B>Id</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"><B>FK</B></TD><TD ALIGN="LEFT" PORT="ProjectId"><B>ProjectId</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Label"><B>Label</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(200)</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Url"><B>Url</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(1000)</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR></TABLE>>];
  Comments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cbd5e1"><TR><TD BGCOLOR="#1e3a8a" COLSPAN="3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Comments</B></FONT></TD></TR><TR><TD BGCOLOR="#eff6ff" ALIGN="CENTER" WIDTH="34"><B>PK</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT" PORT="Id"><B>Id</B></TD><TD BGCOLOR="#eff6ff" ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"><B>FK</B></TD><TD ALIGN="LEFT" PORT="ProjectId"><B>ProjectId</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">INTEGER</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Author"><B>Author</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(200)</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="Text"><B>Text</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT(4000)</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR><TR><TD ALIGN="CENTER" WIDTH="34"></TD><TD ALIGN="LEFT" PORT="CreatedAt"><B>CreatedAt</B></TD><TD ALIGN="LEFT"><FONT COLOR="#334155">TEXT</FONT> <FONT COLOR="#64748b">NOT NULL</FONT></TD></TR></TABLE>>];

  Projects:Id:e -> ProjectMembers:ProjectId:w [xlabel=<<FONT COLOR="#1e3a8a"><B>  1 ... N  </B></FONT>>, arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.3, color="#1e3a8a", arrowsize=1.1, constraint=true];
  Members:Id:e -> ProjectMembers:MemberId:w [xlabel=<<FONT COLOR="#1e3a8a"><B>  1 ... N  </B></FONT>>, arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.3, color="#1e3a8a", arrowsize=1.1, constraint=true];
  Projects:Id:e -> Attachments:ProjectId:w [xlabel=<<FONT COLOR="#1e3a8a"><B>  1 ... N  </B></FONT>>, arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.3, color="#1e3a8a", arrowsize=1.1, constraint=true];
  Projects:Id:e -> Comments:ProjectId:w [xlabel=<<FONT COLOR="#1e3a8a"><B>  1 ... N  </B></FONT>>, arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.3, color="#1e3a8a", arrowsize=1.1, constraint=true];
}
